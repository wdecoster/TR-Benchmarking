// inquiSTR 0.30.0 with an explicit --minlen 2: reproduces the pre-0.30.0 behaviour (1 bp indels not counted).
// A diagnostic set, not a release: its own version label keeps the results apart from the 0.30.0 defaults.
params {
    version_set = 'inquistr_minlen2'
    tool_versions = [
        inquistr : [version: '0.30.0-minlen2', container: 'ghcr.io/wdecoster/inquistr:0.30.0', minlen: 2],
        inquistr_unphased: [version: '0.30.0-minlen2', container: 'ghcr.io/wdecoster/inquistr:0.30.0', minlen: 2],
    ]
}
