// Latest releases, checked 2026-11-17. Rule: re-run a tool only when its major or minor version changed
// since its last benchmarked version; patch releases are not re-run. Under that rule LongTR (1.2, unchanged)
// and Straglr (1.5.6 is a patch over 1.5.5) reuse their paper-version results: they are listed here so the
// set is complete, but are not selected with --tools.
// CLI changes since the paper versions:
//   ATaRVa >= 0.7: subcommand 'atarva genotype', same options
//   STRdust 1.x: --unphased requires a strategy; 'ward' is the documented general choice
params {
    version_set = 'current'
    tool_versions = [
        atarva   : [version: '0.7.1',  container: 'ghcr.io/wdecoster/atarva:0.7.1',  cmd: 'atarva genotype'],
        inquistr : [version: '0.28.2', container: 'ghcr.io/wdecoster/inquistr:0.28.2'],   // own image from the release binary (containers/inquistr) until bioconda has it
        inquistr_unphased: [version: '0.28.2', container: 'ghcr.io/wdecoster/inquistr:0.28.2'],   // same binary with --unphased
        longtr   : [version: '1.2',    container: 'community.wave.seqera.io/library/longtr:1.2--3a7af9434e146eab'],
        mahimahi : [version: '1.0.0',  container: 'ghcr.io/wdecoster/mahimahi:1.0.0'],   // own build from the release wheel (containers/mahimahi)
        medaka   : [version: '2.2.2',  container: 'quay.io/biocontainers/medaka:2.2.2--py312h3050eb1_0'],
        straglr  : [version: '1.5.5',  container: 'community.wave.seqera.io/library/straglr:1.5.5--d8ea229ed1f78ec0', cmd: 'straglr.py'],
        strdust  : [version: '1.4.1',  container: 'quay.io/biocontainers/strdust:1.4.1--hf5b9375_0', cmd: 'STRdust', unphased: '--unphased ward'],
        strkit   : [version: '0.25.0', container: 'ghcr.io/davidlougheed/strkit:0.25.0'],
        vamos    : [version: '3.1.1',  container: 'quay.io/biocontainers/vamos:3.1.1--h5814d7d_0', extra: '-Z', fix_script: 'fix-vcf.py'],
        mosdepth : [version: '0.3.10', container: 'oras://community.wave.seqera.io/library/mosdepth:0.3.10--21ace4b9c76a055d'],
        pysam    : [version: '0.24.1', container: 'quay.io/biocontainers/pysam:0.24.1--py312hf5ad864_0'],
    ]
}
