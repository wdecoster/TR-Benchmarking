// Tool versions as in Aliyev et al. 2026 (Genome Biology 27:343).
// Where the paper used a container, the same image is used. Where it used a local build (ATaRVa, vamos,
// Straglr checkout, STRdust binary, medaka conda env), the container is a build of the same release tag:
// same version, not provably the same build (see docs/FORK.md).
params {
    version_set = 'paper'
    tool_versions = [
        atarva   : [version: '0.5.0',  container: 'ghcr.io/wdecoster/atarva:0.5.0',  cmd: 'atarva'],
        longtr   : [version: '1.2',    container: 'community.wave.seqera.io/library/longtr:1.2--3a7af9434e146eab'],
        medaka   : [version: '2.1.1',  container: 'ghcr.io/wdecoster/medaka:2.1.1'],   // own build: pyabpoa 1.5.1 (see containers/medaka)
        straglr  : [version: '1.5.5',  container: 'community.wave.seqera.io/library/straglr:1.5.5--d8ea229ed1f78ec0', cmd: 'straglr.py'],
        strdust  : [version: '0.16.0', container: 'quay.io/biocontainers/strdust:0.16.0--hcdda2d0_0', cmd: 'STRdust', unphased: '--unphased'],
        strkit   : [version: '0.24.2', container: 'ghcr.io/davidlougheed/strkit:0.24.2'],
        vamos    : [version: '3.0.5',  container: 'quay.io/biocontainers/vamos:3.0.5--h7f5d12c_0', extra: '-Z', fix_script: 'fix-vcf.py'],
        vamos_old: [version: '2.1.7',  container: 'quay.io/biocontainers/vamos:2.1.7--h5ca1c30_0', extra: '',   fix_script: 'fix-vcf-2.1.7.py'],
        mosdepth : [version: '0.3.10', container: 'oras://community.wave.seqera.io/library/mosdepth:0.3.10--21ace4b9c76a055d'],
        pysam    : [version: '0.24.1', container: 'quay.io/biocontainers/pysam:0.24.1--py312hf5ad864_0'],
    ]
}
