// Fork of dashnowlab/TR-Benchmarking. Profiles:
//   executor: 'local' (any single machine, Apptainer) or 'alpine' (the original CU Boulder Slurm settings)
//   versions: 'paper' (Aliyev et al. 2026) or 'current' (latest releases)
// Launch from the results folder (pipeline_info/ and .nextflow/ land in the launch dir), e.g.
// nextflow run main.nf -profile local,paper -c conf/local/<site>.config --list samples.list

manifest {
    name            = 'TR-Benchmarking (fork)'
    homePage        = 'https://github.com/wdecoster/TR-Benchmarking'
    description     = 'Benchmark of long-read tandem repeat genotypers, derived from dashnowlab/TR-Benchmarking'
    nextflowVersion = '>=24.10.0'
}

params {
    version_set   = null
    tool_versions = [:]
}

def stamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

// Timing: realtime (wall) and %cpu give CPU time = realtime * %cpu / 100, which is far less
// sensitive to other load on the machine than wall time. loadavg is logged per task (see below).
trace {
    enabled = true
    file    = "pipeline_info/trace_${stamp}.tsv"
    fields  = 'task_id,hash,name,tag,status,exit,container,cpus,memory,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,start,complete,workdir'
}
report   { enabled = true; file = "pipeline_info/report_${stamp}.html" }
timeline { enabled = true; file = "pipeline_info/timeline_${stamp}.html" }

process {
    // load on the machine at task start and end, to judge whether a timing was disturbed
    beforeScript = 'cat /proc/loadavg > .loadavg_start'
    afterScript  = 'cat /proc/loadavg > .loadavg_end'
    errorStrategy = { task.attempt <= 1 ? 'retry' : 'finish' }
    maxRetries = 1
}

profiles {
    paper   { includeConfig 'conf/versions_paper.config' }
    current { includeConfig 'conf/versions_current.config' }

    local {
        process.executor   = 'local'
        apptainer.enabled  = true
        apptainer.autoMounts = true
    }

    // Docker instead of Apptainer (a workstation without Apptainer; used for the timing runs on a laptop)
    docker {
        process.executor   = 'local'
        docker.enabled     = true
        docker.entrypointOverride = true   // the strkit image has ENTRYPOINT strkit; Apptainer ignores entrypoints, Docker does not
        docker.runOptions  = '-u $(id -u):$(id -g)'
    }

    // Original settings used on CU Boulder Alpine (unchanged apart from moving into a profile)
    alpine {
        conda.enabled = true
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.cacheDir = '/pl/active/dashnowlab/projects/TR-benchmarking/cache'
        process {
            executor = 'slurm'
            queue = { task.memory <= 240.GB ? 'amilan' : 'amem' }
            clusterOptions = {
                if (task.memory > 240.GB) { '--qos=mem' }
                else if (task.time > 24.h) { '--qos=long' }
                else { '--qos=normal' }
            }
            maxRetries = 3
            errorStrategy = { task.attempt <= process.maxRetries ? 'retry' : 'finish' }
            resourceLimits = [cpus: 48, memory: 240.GB, time: 72.h]
        }
        executor {
            name = 'slurm'
            queueSize = 48
            perJobMemLimit = true
            submitRateLimit = '30 / 1 min'
            killBatchSize = 50
        }
    }
}
